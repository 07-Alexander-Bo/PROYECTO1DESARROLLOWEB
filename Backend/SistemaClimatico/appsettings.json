{
  "Jwt": {
    "Issuer": "SistemaClimaticoAPI",
    "Audience": "SistemaClimaticoFrontend",
    "ExpiresMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Simulador": {
    "Habilitado": true,
    "IntervaloSegundos": 5,
    "ProbabilidadEvento": 0.004,
    "CrearSensoresDemo": true
  },
  "Alertas": {
    "CooldownMinutos": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
