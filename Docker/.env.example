# Copia este archivo como ".env" (en esta misma carpeta) y cambia los valores.
# El archivo ".env" NO se sube a GitHub; este ".env.example" si.
#
# IMPORTANTE: no uses los caracteres  $  ;  "  ni espacios en las contrasenas
# (rompen la cadena de conexion o la lectura de este archivo).

# ---------------- Base de datos ----------------
# SQL Server exige una contrasena fuerte: minimo 8 caracteres con mayusculas,
# minusculas, numeros y simbolos.
MSSQL_SA_PASSWORD=CambiaEstaPassword_123!

# Memoria maxima para SQL Server (MB). SQL Server necesita al menos ~2 GB de RAM en la VPS;
# con 2 GB de RAM total baja esto a 1024 y agrega memoria swap (ver docs/DESPLIEGUE.md).
MSSQL_MEMORY_LIMIT_MB=2048

# ---------------- API ----------------
# Clave secreta para firmar los tokens de inicio de sesion (JWT): minimo 32 caracteres.
# Genera una con:   openssl rand -hex 32
JWT_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas-caracteres

# Primer administrador (se crea solo si aun no existe ninguno)
ADMIN_CORREO=admin@midominio.com
ADMIN_PASSWORD=CambiaEstaClave_123!
ADMIN_NOMBRE=Administrador

# ---------------- Sitio web ----------------
# Direccion con la que se abre el sitio.
#   Sin dominio (HTTP):   :80          y   PUBLIC_URL=http://IP-DE-TU-VPS
#   Con dominio (HTTPS):  midominio.com   y   PUBLIC_URL=https://midominio.com
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost

# ---------------- Simulador (opcional) ----------------
# Cada cuantos segundos genera una lectura cada sensor, y que tan seguido hay eventos extremos.
SIMULADOR_INTERVALO=5
SIMULADOR_PROBABILIDAD=0.004
